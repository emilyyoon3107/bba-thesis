**# [IDENTIFIERS] rename and label
gen double currfamid = year * 100000 + idfam // idfam 5 digits max

label variable uniqueid "1968 Historical Unique Permanent Individual ID"
label variable extfamid "1968 Historical Unique Extended Family ID"
label variable extfamseqno "Individual Number within 1968 Historical Family or Extended Family"
label variable currfamid "Current Wave-Specific Family ID" 

drop if seqnum == 0 // drops 279,026 nonexistent individual-year obs


**# [CHECK] size of extended family
preserve
quietly{
keep uniqueid extfamid
duplicates drop
bysort extfamid: gen n_extfamid = _N
keep uniqueid n_extfamid
duplicates drop
}
disp "=== INDIVIDUALS PER 1968 HISTORICAL FAMILY (Extended Family) ==="
sum n_extfamid, detail
restore

**# [CHECK] size of current family
preserve
quietly{
keep currfamid uniqueid
duplicates drop
bysort currfamid: gen n_currfamid = _N
keep currfamid n_currfamid
duplicates drop
}
disp "=== INDIVIDUALS PER CURRENT HOUSEHOLD (Current Immediate Family) ==="
sum n_currfamid, detail
// check that summary variables are what is to be expected for a single family
// note: includes institutions as well so largest numbers can be big
restore

**# [CHECK] single heads per current family
preserve
keep if seqnum == 1
keep currfamid uniqueid
duplicates drop
bysort currfamid: gen n_currfamid = _N
keep currfamid n_currfamid
duplicates drop
assert n_currfamid == 1
restore

**# [IDENTIFIERS] keep only house heads to ensure one row per current family
keep if seqnum == 1
xtset uniqueid year
// panel with i = uniqueid, j = year
// This treats splitoffs as different families.
// Note: one case where a single immediate family may be split into different is is when the head (or representative person) changes, without a change in FU members

